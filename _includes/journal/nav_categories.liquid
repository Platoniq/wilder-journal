{% comment %}
  Site-level override of the theme's vertical category menu.
  Identical to the theme version, plus two things: unlabelled categories are
  skipped, and a "Vídeos" entry is appended after the categories so
  videos appear as their own section next to Stories/Interviews/etc. in every
  volume. Videos are shared across all volumes (same content), so the entry
  links to the global Videos page rather than a per-volume view.
  The Newsletter section is linked from the "..." menu instead
  (default/header_sitemap_selector.liquid), not from here.
  Keep in sync with the theme's nav_categories.liquid on theme bumps.
{% endcomment %}
<nav class="pj-nav-vertical">
  <ul>
  {% comment %}
    Newsletter pages belong to no volume, so fall back to the latest published
    volume there; the section links then lead back into the current edition.
  {% endcomment %}
  {% assign nav_volume = current_volume %}
  {% unless nav_volume %}
    {% assign nav_volume = site.volumes | where: "locale", page.locale | where: "published", true | sort: "volume-number", "last" | last %}
  {% endunless %}
  {% assign volume_archives = site.archives | where: "locale", page.locale | where: "volume-uid", nav_volume.uid | sort: "order" %}
  {% for archive in volume_archives %}
    {% assign t_category_name = site.data.i18n[page.locale].categories[archive.category] | strip %}

    {% comment %}
      Volume 1 carries "blueprints" and "reports" archives that have no entry in the
      theme's categories.yml, so they rendered as blank clickable items above Futuros
      — a visible gap in the strip on volume 1 only. Skip anything with no label
      rather than invent category names; add them to categories.yml to bring back.
    {% endcomment %}
    {% if t_category_name == "" %}{% continue %}{% endif %}

    <li>
      <a href="{{ archive.url  | relative_url }}" class="{% if page.category == archive.category %}select{% endif %}">
        <strong>
          {{ t_category_name }}
        </strong>
      </a>
    </li>
  {% endfor %}

  {% assign videos_page = site.pages | where: "uid", "videos" | where: "locale", page.locale | first %}
  {% if videos_page %}
    <li>
      <a href="{{ videos_page.url | relative_url }}" class="{% if page.uid == 'videos' %}select{% endif %}">
        <strong>
          {{ site.data.i18n[page.locale].global.videos_menu }}
        </strong>
      </a>
    </li>
  {% endif %}

  </ul>
</nav>
